NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
# Isi dengan publishable key (format baru pengganti anon key): sb_publishable_...
# Diamkan placeholder agar route mengembalikan ENV_MISSING sampai env asli diset
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Wajib untuk server/admin saja (jangan pakai prefix NEXT_PUBLIC_). Isi dari
# Dashboard > Settings > API Keys > secret key (sb_secret_...). Jangan commit
# nilai aslinya, file ini hanya template.
SUPABASE_SECRET_KEY=sb_secret_...
